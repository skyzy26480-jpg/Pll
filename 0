local function GetTargetPosition(character)
    local head = character:FindFirstChild("Head")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not head or not rootPart then return nil end

    if Settings.TargetPart == "⚡ หัว + ตัว (สายฟ้าฟาด)" then
        return head.Position + Vector3.new(0, 0.1, 0)
    elseif Settings.TargetPart == "Neck" then
        return (head.Position + rootPart.Position) / 2
    elseif Settings.TargetPart == "Body" then
        return rootPart.Position
    else
        return head.Position
    end
end

local function GetClosestTarget()
    local closestPosition = nil
    local shortestDistance = Settings.FOVRadius
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local targetPos = GetTargetPosition(player.Character)
            if targetPos then
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
                if onScreen then
                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if distance <= shortestDistance then
                        shortestDistance = distance
                        closestPosition = targetPos
                    end
                end
            end
        end
    end
    return closestPosition
end

-- ESP System
local function UpdateESP()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not espCache[player] then
                espCache[player] = {
                    Box = Drawing.new("Square"),
                    Tracer = Drawing.new("Line"),
                    NameTag = Drawing.new("Text"),
                    HealthBarOutline = Drawing.new("Square"),
                    HealthBar = Drawing.new("Square"),
                    HealthText = Drawing.new("Text")
                }
                
                espCache[player].Box.Visible = false
                espCache[player].Box.Color = Color3.fromRGB(255, 255, 255)
                espCache[player].Box.Thickness = 1.5
                espCache[player].Box.Filled = false
                
                espCache[player].Tracer.Visible = false
                espCache[player].Tracer.Color = Color3.fromRGB(255, 255, 255)
                espCache[player].Tracer.Thickness = 1
                
                espCache[player].NameTag.Visible = false
                espCache[player].NameTag.Color = Color3.fromRGB(255, 255, 255)
                espCache[player].NameTag.Size = 13
                espCache[player].NameTag.Center = true
                espCache[player].NameTag.Outline = true

                espCache[player].HealthBarOutline.Visible = false
                espCache[player].HealthBarOutline.Color = Color3.fromRGB(0, 0, 0)
                espCache[player].HealthBarOutline.Filled = true

                espCache[player].HealthBar.Visible = false
                espCache[player].HealthBar.Color = Color3.fromRGB(0, 255, 0)
                espCache[player].HealthBar.Filled = true

                espCache[player].HealthText.Visible = false
                espCache[player].HealthText.Color = Color3.fromRGB(0, 255, 0)
                espCache[player].HealthText.Size = 12
                espCache[player].HealthText.Outline = true
            end

            local cache = espCache[player]
            local char = player.Character
            
            if myRoot and char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Head") then
                local humanoid = char.Humanoid
                local rootPart = char.HumanoidRootPart
                local head = char.Head
                
                local distance = (rootPart.Position - myRoot.Position).Magnitude
                
                if distance <= Settings.MaxESPDistance then
                    local topPosition = head.Position + Vector3.new(0, 0.5, 0)
                    local bottomPosition = rootPart.Position - Vector3.new(0, 2.8, 0)
                    
                    local headPos, headOnScreen = Camera:WorldToViewportPoint(topPosition)
                    local legPos, legOnScreen = Camera:WorldToViewportPoint(bottomPosition)
                    local rootPos, rootOnScreen = Camera:WorldToViewportPoint(rootPart.Position)
                    
                    if headOnScreen and headPos.Z > 0 then
                        local height = math.abs(headPos.Y - legPos.Y)
                        local width = height / 1.8
                        if height < 12 then height = 12 end

                        -- Box & Top Tracer
                        if Settings.ESPEnabled then
                            cache.Box.Size = Vector2.new(width, height)
                            cache.Box.Position = Vector2.new(headPos.X - width / 2, headPos.Y)
                            cache.Box.Visible = true
                            
                            cache.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, 0)
                            cache.Tracer.To = Vector2.new(rootPos.X, rootPos.Y)
                            cache.Tracer.Visible = true
                        else
                            cache.Box.Visible = false
                            cache.Tracer.Visible = false
                        end

                        -- Health Bar
                        if Settings.ESPEnabled and Settings.HealthESPEnabled then
                            local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                            local barWidth = 3
                            local barX = (headPos.X - width / 2) - barWidth - 4
                            local barY = headPos.Y

                            cache.HealthBarOutline.Size = Vector2.new(barWidth + 2, height + 2)
                            cache.HealthBarOutline.Position = Vector2.new(barX - 1, barY - 1)
                            cache.HealthBarOutline.Visible = true

                            local currentBarHeight = height * healthPercent
                            cache.HealthBar.Size = Vector2.new(barWidth, currentBarHeight)
                            cache.HealthBar.Position = Vector2.new(barX, barY + (height - currentBarHeight))
                            cache.HealthBar.Visible = true

                            cache.HealthText.Text = math.floor(humanoid.Health) .. " HP"
                            cache.HealthText.Position = Vector2.new(barX - 38, barY + (height / 2) - 6)
                            cache.HealthText.Visible = true
                        else
                            cache.HealthBarOutline.Visible = false
                            cache.HealthBar.Visible = false
                            cache.HealthText.Visible = false
                        end

                        -- Name Tag
                        if Settings.NameESPEnabled then
                            cache.NameTag.Text = player.Name
                            cache.NameTag.Position = Vector2.new(headPos.X, headPos.Y - 15)
                            cache.NameTag.Visible = true
                        else
                            cache.NameTag.Visible = false
                        end
                    else
                        cache.Box.Visible = false
                        cache.Tracer.Visible = false
                        cache.NameTag.Visible = false
                        cache.HealthBarOutline.Visible = false
                        cache.HealthBar.Visible = false
                        cache.HealthText.Visible = false
                    end
                else
                    cache.Box.Visible = false
                    cache.Tracer.Visible = false
                    cache.NameTag.Visible = false
                    cache.HealthBarOutline.Visible = false
                    cache.HealthBar.Visible = false
                    cache.HealthText.Visible = false
                end
            else
                cache.Box.Visible = false
                cache.Tracer.Visible = false
                cache.NameTag.Visible = false
                cache.HealthBarOutline.Visible = false
                cache.HealthBar.Visible = false
                cache.HealthText.Visible = false
            end
        end
    end
end

Players.PlayerRemoving:Connect(function(player)
    if espCache[player] then
        espCache[player].Box:Remove()
        espCache[player].Tracer:Remove()
        espCache[player].NameTag:Remove()
        espCache[player].HealthBarOutline:Remove()
        espCache[player].HealthBar:Remove()
        espCache[player].HealthText:Remove()
        espCache[player] = nil
    end
end)

-- Main Loop
RunService.RenderStepped:Connect(function()
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    FOVCircle.Position = screenCenter
    FOVCircle.Radius = Settings.FOVRadius
    FOVCircle.Color = fovColorOptions[Settings.FOVColorName] or Color3.fromRGB(255, 255, 255)
    FOVCircle.Visible = Settings.FOVEnabled

    UpdateESP()

    if Settings.AimbotEnabled and isLockActive then
        local targetPos = GetClosestTarget()
        if targetPos then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
        end
    end
end)
