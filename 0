local function AddToggle(parent, text, defaultState, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
    btn.BorderColor3 = Color3.fromRGB(50, 50, 50)
    btn.BorderSizePixel = 1
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    
    local state = defaultState
    local function updateText()
        btn.Text = "   " .. text .. ": " .. (state and "[ เปิด ]" or "[ ปิด ]")
    end
    updateText()

    btn.MouseButton1Click:Connect(function()
        state = not state
        updateText()
        callback(state)
    end)
    
    local UIListLayout = parent:FindFirstChildOfClass("UIListLayout")
    if not UIListLayout then
        local layout = Instance.new("UIListLayout")
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Padding = UDim.new(0, 8)
        layout.Parent = parent
    end

    btn.Parent = parent
    return btn
end

local function AddSelector(parent, text, options, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
    btn.BorderColor3 = Color3.fromRGB(50, 50, 50)
    btn.BorderSizePixel = 1
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.TextColor3 = Color3.fromRGB(220, 220, 220)

    local currentIndex = 1
    btn.Text = "   " .. text .. ": " .. options[currentIndex]

    btn.MouseButton1Click:Connect(function()
        currentIndex = currentIndex + 1
        if currentIndex > #options then currentIndex = 1 end
        btn.Text = "   " .. text .. ": " .. options[currentIndex]
        callback(options[currentIndex])
    end)

    btn.Parent = parent
    return btn
end

